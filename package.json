{
	"name": "@prc/icon-library",
	"description": "Fontawesome based icon library for PRC Design System",
	"license": "GPL-2.0-or-later",
	"dependencies": {
		"@fortawesome/free-brands-svg-icons": "^6.7.2",
		"@fortawesome/free-regular-svg-icons": "^6.7.2",
		"@fortawesome/free-solid-svg-icons": "^6.7.2"
	},
	"devDependencies": {
		"@wordpress/scripts": "^31.4.0",
		"babel-plugin-macros": "^3.1.0"
	},
	"scripts": {
		"build:fill-svgs": "node ./bin/build-fill-svgs.mjs",
		"generate:icon-manifest": "node ./bin/generate-icon-manifest.mjs",
		"build:icon-compare-sheet": "node ./bin/build-compare-sheet.mjs",
		"icons:map-chrome": "node ./bin/map-chrome-icons.mjs",
		"icons:check": "node ./bin/build-fill-svgs.mjs --check && node ./bin/generate-icon-manifest.mjs --check && node ./bin/map-chrome-icons.mjs --check && node ./bin/scan-icon-call-sites.mjs --check && node ./bin/check-fa-pro-gone.mjs",
		"icons:audit-repo": "node ./bin/scan-repo-icon-refs.mjs",
		"icons:scan-call-sites": "node ./bin/scan-icon-call-sites.mjs",
		"test": "node --test ../../tests/prc-icon-library/unit/*.test.mjs"
	},
	"version": "1.3.0"
}
